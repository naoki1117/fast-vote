// Fast Vote のデータ定義。PostgreSQL（Supabase）向け。
// url は Prisma 5 ではここに env() を書く。Prisma 7 の書き方とは違う。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // 通常クエリ用（プール 6543）
  directUrl = env("DIRECT_URL")   // db push / migrate 用（5432）
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String
  // 提案は1人1件。逆向きは Post.author
  proposal      Post?     @relation("UserProposal")
  votes         Vote[]
  resetRequest  ResetRequest?
  advanceRequests AdvanceRequest[]
  hostedCompany Company?  @relation("CompanyHost")
  nominationsGiven    HostNomination[] @relation("NominationBy")
  nominationsReceived HostNomination[] @relation("NominationFor")
  messages            Message[]
  // 会社を消すと所属ユーザーも消える
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String?   @map("company_id")
  // ログイン中だけラウンドのメンバーに含める。ログアウトで外す
  isPresent     Boolean   @default(false) @map("is_present")

  @@map("users")
}

// 各ユーザーが出せる提案は1件まで（authorId がユニーク）
model Post {
  id        String   @id @default(cuid())
  title     String
  content   String
  author    User     @relation("UserProposal", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String   @unique @map("author_id")
  votes     Vote[]
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?  @map("company_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
}

// 同じ会社のメンバーが作業中に話すチャット。1人何件でも可
model Message {
  id        String   @id @default(cuid())
  content   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String   @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@map("messages")
}

// ユーザーが提案に投じた票。同じ提案への二重投票は @@unique で防ぐ
model Vote {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String @map("post_id")

  @@unique([userId, postId])
  @@map("votes")
}

model Company {
  id              String           @id @default(cuid())
  name            String
  users           User[]
  posts           Post[]
  resetRequests   ResetRequest[]
  advanceRequests AdvanceRequest[]
  hostNominations HostNomination[]
  messages        Message[]
  roundSignal     RoundSignal?
  host            User?            @relation("CompanyHost", fields: [hostId], references: [id], onDelete: SetNull)
  hostId          String?          @unique @map("host_id")
  topicTitle      String?          @map("topic_title")
  topicContent    String?          @map("topic_content")
  // 欠席者を待たず、半数以上の申請で指名／提案を締め切る
  skipNominate    Boolean          @default(false) @map("skip_nominate")
  skipPropose     Boolean          @default(false) @map("skip_propose")

  @@map("companies")
}

// 各ラウンド、メンバーが1人をホストに指名する
model HostNomination {
  id        String   @id @default(cuid())
  user      User     @relation("NominationBy", fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique @map("user_id")
  nominee   User     @relation("NominationFor", fields: [nomineeId], references: [id], onDelete: Cascade)
  nomineeId String   @map("nominee_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String   @map("company_id")
  createdAt DateTime @default(now())

  @@map("host_nominations")
}

// 欠席者を待たず、いまのメンバーだけで次へ進む申請（指名／提案の段階ごと）
model AdvanceRequest {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String   @map("company_id")
  stage     String
  createdAt DateTime @default(now())

  @@unique([userId, stage])
  @@index([companyId, stage])
  @@map("advance_requests")
}

// 投票完了後、全員が申請すると提案と票を消して次のラウンドに戻す
model ResetRequest {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique @map("user_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String   @map("company_id")
  createdAt DateTime @default(now())

  @@map("reset_requests")
}

// Realtime 通知用。中身は会社IDと更新時刻だけ（提案や票は載せない）
model RoundSignal {
  companyId String   @id @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bumpedAt  DateTime @updatedAt @map("bumped_at")

  @@map("round_signals")
}
